{
  "name": "kmart-ai", "private": true, "version": "0.1.0",
  "workspaces": ["services/*", "packages/*", "apps/*"],
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev:api": "npm run dev -w @kmart/api", "dev:admin": "npm run dev -w @kmart/admin", "dev:mobile": "npm run start -w @kmart/mobile",
    "lint": "eslint .", "typecheck": "npm run typecheck --workspaces --if-present", "test": "npm run test --workspaces --if-present", "build": "npm run build --workspaces --if-present", "format": "prettier --write ."
  },
  "devDependencies": {"@eslint/js": "^9.39.0", "eslint": "^9.39.0", "typescript-eslint": "^8.50.0", "typescript": "~5.9.3", "prettier": "^3.7.4", "@types/node": "^22.19.0"}
}
